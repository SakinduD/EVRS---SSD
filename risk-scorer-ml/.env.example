# Copy to .env and fill in. Do not commit .env.

# Paths to the model and feature schema. Both are resolved relative to the
# service directory and MUST stay inside it - the loader rejects paths that
# escape it (V14, path traversal into the deserialiser).
MODEL_PATH=./evrs_miss_next_model.pkl
SCHEMA_PATH=./evrs_feature_schema.json

# Scoring configuration.
HORIZON_DAYS=120
HIGH_THR=0.65
MED_THR=0.35

# V14 - artifact integrity pinning.
# The expected SHA-256 digests live in artifacts.lock.json, which IS tracked in
# git so that changing a pin is visible in review. These variables exist only as
# a fallback for deployments that inject digests out of band; leave them empty.
# Regenerate the lock file after retraining with:
#   python tools/checksum_artifacts.py --write
MODEL_SHA256=
SCHEMA_SHA256=

# Local development only. When true, a missing pin is logged as a warning
# instead of aborting startup. Never enable this in a deployed environment.
ALLOW_UNVERIFIED_ARTIFACTS=false

# Audit logging. Integrity results are security events and are written to both
# the console and this file. Leave LOG_FILE unset to use ./logs/scorer.log.
LOG_LEVEL=INFO
LOG_FILE=

# V13 - shared secret that callers must present as the X-Internal-Token header.
# The service refuses to start without it, because an unauthenticated scoring
# endpoint exposes citizen health data to anyone who can reach the port.
# Must be at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# The Node backend must hold the SAME value in its own INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=

# V13 - comma-separated browser origins allowed to call this service directly.
# Leave empty. The Node backend calls it server-to-server, where CORS plays no
# part, and '*' is rejected outright.
ALLOWED_ORIGINS=

# Port the service binds to when run directly with `python app.py`.
# It binds to 127.0.0.1 only; nothing should expose it publicly.
PORT=8081

# V15 - input bounds.
# Maximum citizens accepted in one /score request. The Node backend currently
# sends every patient in one payload with no batching, so raise this only
# alongside batching on the caller's side, never to remove the bound.
MAX_EVENTS_PER_REQUEST=1000

# Maximum request body in bytes. Checked from Content-Length before the body is
# read, because FastAPI buffers the whole body before validation runs.
MAX_BODY_BYTES=8388608

# V16 - development-only surfaces. When true this serves /docs, /redoc and
# /openapi.json, enables uvicorn's auto-reloader, and logs a warning at startup.
# The reloader re-imports code when a watched file changes, so leaving this on
# in a deployed environment turns file-write access into code execution.
DEBUG_MODE=false

# Interface to bind to. Keep it on loopback unless the Node backend runs on a
# different host, and put the service behind the network boundary if it does.
HOST=127.0.0.1
