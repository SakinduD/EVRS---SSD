# Copy to .env and fill in. Do not commit .env.

# Paths to the model and feature schema. Both are resolved relative to the
# service directory and MUST stay inside it - the loader rejects paths that
# escape it (V14, path traversal into the deserialiser).
MODEL_PATH=./evrs_miss_next_model.pkl
SCHEMA_PATH=./evrs_feature_schema.json

# Scoring configuration.
HORIZON_DAYS=120
HIGH_THR=0.65
MED_THR=0.35

# V14 - artifact integrity pinning.
# The expected SHA-256 digests live in artifacts.lock.json, which IS tracked in
# git so that changing a pin is visible in review. These variables exist only as
# a fallback for deployments that inject digests out of band; leave them empty.
# Regenerate the lock file after retraining with:
#   python tools/checksum_artifacts.py --write
MODEL_SHA256=
SCHEMA_SHA256=

# Local development only. When true, a missing pin is logged as a warning
# instead of aborting startup. Never enable this in a deployed environment.
ALLOW_UNVERIFIED_ARTIFACTS=false

# Audit logging. Integrity results are security events and are written to both
# the console and this file. Leave LOG_FILE unset to use ./logs/scorer.log.
LOG_LEVEL=INFO
LOG_FILE=
